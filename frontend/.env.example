# Lumirise Frontend Environment Variables

# Production API URL — set this in Vercel project settings
# Example: https://lumirise-api.vercel.app/api
VITE_API_URL=http://localhost:5000/api

# Development Persona Switcher Feature Flag
# Set to 'true' only during local developer testing. Default is 'false' (strictly hidden in production).
VITE_ENABLE_PERSONA_SWITCHER=false
