# =============================================================================
# LUMIRISE ENTERPRISE ERP — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Fill in values for your production deployment.
# NEVER commit real credentials or production secrets to version control.

# SERVER CONFIGURATION
PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://your-lumirise-domain.com

# DATABASE CONNECTION (PostgreSQL)
# Supported Providers: Neon, Supabase, AWS RDS, GCP Cloud SQL, Azure PostgreSQL, or Self-Hosted
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?sslmode=require&connection_limit=20
#
# Examples:
# - Neon / Supabase (Pooled connection):
#   DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST-pooler.region>.pooler.supabase.com:6543/<DB_NAME>?pgbouncer=true&connection_limit=20&sslmode=require"
#   DIRECT_URL="postgresql://<USER>:<PASSWORD>@<HOST.region>.supabase.com:5432/<DB_NAME>?sslmode=require"
#
# - AWS RDS / GCP Cloud SQL:
#   DATABASE_URL="postgresql://<USER>:<PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require&connection_limit=20"
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?sslmode=require"

# AUTHENTICATION & SECURITY
# Generate a strong 64-character secret using: openssl rand -hex 32
JWT_SECRET=your-production-jwt-secret-min-32-chars-long
JWT_EXPIRES_IN=8h

# MULTI-TENANCY & COMPLIANCE
DEFAULT_ORGANIZATION_CODE=ORG-LUMIRISE
AUDIT_LOG_RETENTION_DAYS=365
